rules_version = '2';

// ============================================================================
// Go Gourmet — règles Firestore
//
// Principe : `request.auth != null` ne protège rien. L'application est publiée
// publiquement, donc tout compte Google au monde satisfait cette condition.
// Le cloisonnement se fait par foyer, sur le champ `householdId` que portent
// tous les documents.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // Le foyer de l'utilisateur courant, ou null si sa fiche n'existe pas
    // encore (premier passage, entre la connexion et la création du document).
    function userHousehold() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && userDoc.data != null ? userDoc.data.householdId : null;
    }

    function inHousehold(householdId) {
      let mine = userHousehold();
      return signedIn() && householdId != null && mine != null && mine == householdId;
    }

    // ---- Utilisateurs -----------------------------------------------------
    // Chacun ne voit que sa propre fiche. Aucun écran de l'application ne lit
    // celle d'un autre : restreindre ici ne casse rien et ferme l'énumération
    // des adresses e-mail.

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // ---- Foyers -----------------------------------------------------------

    match /households/{householdId} {
      // `get` reste ouvert : rejoindre un foyer par lien d'invitation suppose
      // de pouvoir lire un document dont on n'est pas encore membre.
      // `list` est fermé, sinon la collection entière s'énumère.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if signedIn() && (
        // Membre ou créateur : plein droit sur le foyer.
        request.auth.uid in resource.data.members ||
        request.auth.uid == resource.data.createdBy ||

        // Rejoindre : un non-membre peut s'ajouter à `members`, mais
        // UNIQUEMENT cela. Sans ce verrou, n'importe qui pouvait renommer le
        // foyer ou en évincer les membres au passage.
        (
          request.auth.uid in request.resource.data.members &&
          !(request.auth.uid in resource.data.members) &&
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['members', 'updatedAt'])
        )
      );

      allow delete: if signedIn()
                    && request.auth.uid == resource.data.createdBy;
    }

    // ---- Recettes ---------------------------------------------------------

    match /recipes/{recipeId} {
      allow read, update, delete: if inHousehold(resource.data.householdId);
      allow create: if inHousehold(request.resource.data.householdId);
    }

    // ---- Ingrédients ------------------------------------------------------
    // Le catalogue « global » est partagé par tous les foyers en lecture,
    // mais reste non modifiable depuis l'application.

    match /ingredients/{ingredientId} {
      allow read: if inHousehold(resource.data.householdId)
                  || (signedIn() && resource.data.householdId == 'global');
      allow update, delete: if inHousehold(resource.data.householdId);
      allow create: if inHousehold(request.resource.data.householdId);
    }

    // ---- Plannings de repas -----------------------------------------------

    match /mealPlans/{planId} {
      allow read, update, delete: if inHousehold(resource.data.householdId);
      allow create: if inHousehold(request.resource.data.householdId);
    }

    // ---- Modèles de semaine -----------------------------------------------

    match /mealPlanTemplates/{templateId} {
      allow read, update, delete: if inHousehold(resource.data.householdId);
      allow create: if inHousehold(request.resource.data.householdId);
    }

    // ---- Articles permanents ----------------------------------------------
    // L'identifiant du document est déjà celui du foyer : le contrôle se fait
    // sur le chemin, ce qui fonctionne aussi quand le document n'existe pas
    // encore (cas du tout premier article ajouté).

    match /permanentShoppingItems/{householdId} {
      allow read, write: if inHousehold(householdId);
    }

    // ---- Refus par défaut -------------------------------------------------
    // Toute collection non listée ci-dessus est fermée.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
