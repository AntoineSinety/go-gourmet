rules_version = '2';

// ============================================================================
// Go Gourmet — règles Storage
//
// Une tentative de cloisonnement par foyer via `firestore.get()` a été
// retirée : les lectures inter-services (Storage → Firestore) exigent une
// autorisation IAM supplémentaire sur l'agent de service Firebase Rules. Sans
// elle, l'appel échoue et la règle refuse TOUT — y compris les membres
// légitimes, ce qui cassait l'envoi de photos.
//
// Le cloisonnement des photos par foyer reste souhaitable, mais il passe par
// un custom claim `householdId` sur le jeton d'authentification (via une
// Cloud Function), pas par une lecture Firestore depuis ces règles.
//
// À savoir de toute façon : les URL rendues par getDownloadURL() portent un
// jeton et sont servies sans passer par ces règles. Elles protègent l'accès
// par chemin et les écritures, pas une URL déjà connue.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    match /households/{householdId}/{type}/{fileName} {

      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && (type == 'recipes' || type == 'ingredients')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null;
    }

    // Catalogue d'ingrédients partagé par tous les foyers : lecture pour les
    // utilisateurs connectés, écriture réservée aux scripts d'administration
    // (le SDK admin ne passe pas par ces règles).
    match /global/ingredients/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Tout le reste du bucket est fermé à l'API Storage.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
